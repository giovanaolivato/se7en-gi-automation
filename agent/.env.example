# .env da Gi. Copie para .env e preencha com valores reais.

# Provedor LLM (endpoint compatível com OpenAI). Atualmente usando NVIDIA
# (free tier — tem instabilidade/latência conhecida, ver README).
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Alternativa Gemini (pago, não testado a fundo — ver README para
# limitações de qualidade encontradas nos testes):
# LLM_API_KEY=sua-chave-gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash-lite

# Limite de requisições/minuto pro rate limiter interno.
LLM_MAX_REQUESTS_PER_MINUTE=20

# WAHA (mesma API_KEY do .env raiz).
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=mesma-chave-do-env-raiz

# Porta do servidor da Gi.
PORT=3001

# ElevenLabs — atualmente NÃO USADO (Gi responde só em texto, decisão
# explícita). Deixe em branco ou remova se não for reativar TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Grupos reais do WhatsApp — desligado até confirmação explícita de ir ao
# ar. Descomente e preencha só quando decidir ativar.
# TARGET_GROUP_IDS=id1@g.us,id2@g.us

# Licenciados individuais liberados pra teste em DM — desligado por
# padrão (só self-chat). Descomente e preencha pra reativar.
# ALLOWED_DM_CONTACTS=numero1@lid,numero2@lid
