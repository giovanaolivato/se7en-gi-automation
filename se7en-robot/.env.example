# .env do se7en-robot. Copie para .env e preencha com valores reais.

# Porta do serviço local (so' escuta em 127.0.0.1, nunca exponha na rede).
PORT=3002

# Chave compartilhada que o bot de WhatsApp precisa enviar no header
# "x-robot-key" em toda chamada. Gere uma nova no computador novo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBOT_SHARED_KEY=gere-uma-chave-forte-aqui

# URL base do portal (normalmente nao precisa mudar).
SE7EN_BASE_URL=https://vendas.se7enpay.com.br

# Rodar o Chromium visivel (false) ajuda a depurar o primeiro login.
# Depois que a sessao estiver salva, pode rodar headless (true).
HEADLESS=true

# --- bot de WhatsApp (mesmos valores de WAHA_* do agent/.env) ---
WHATSAPP_PORT=3003
ROBOT_URL=http://127.0.0.1:3002
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=mesma-chave-do-env-raiz
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813
