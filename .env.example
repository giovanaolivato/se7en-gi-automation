# .env do serviço WAHA (docker-compose.yml). Copie para .env e preencha.

# Senha do dashboard web do WAHA (http://localhost:3000/dashboard).
DASH_PASS=troque-por-uma-senha-forte

# Chave de API que protege os endpoints REST do WAHA — mesma chave usada
# em agent/.env e se7en-robot/.env (WAHA_API_KEY).
API_KEY=gere-uma-chave-forte-aqui
